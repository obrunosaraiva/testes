{
  "name": "constelar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Campo de constelação familiar sistêmica por teleterapia — sala virtual + bonecos 3D",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --experimental-sqlite server/index.mjs\"",
    "dev:web": "vite",
    "dev:server": "node --experimental-sqlite server/index.mjs",
    "server": "node --experimental-sqlite server/index.mjs",
    "start": "node --experimental-sqlite server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "express": "^4.21.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "ws": "^8.18.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
