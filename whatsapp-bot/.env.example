# URL do backend GTD
GTD_API_URL=http://localhost:8000/api

# Grupos a monitorar (separados por vírgula). Deixe vazio para monitorar TODOS.
# Exemplo: MONITORED_GROUPS=Projeto Alpha,Time Dev,Demandas Produto
MONITORED_GROUPS=

# Remetentes a ignorar (separados por vírgula)
IGNORED_SENDERS=

# Tamanho mínimo da mensagem para processar (evita "ok", emojis, etc.)
MIN_MESSAGE_LENGTH=15
