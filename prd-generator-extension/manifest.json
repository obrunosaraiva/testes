{
  "manifest_version": 3,
  "name": "PRD Generator para Claude Code",
  "version": "0.1.0",
  "description": "Mini chat de IA que transforma uma ideia simples em um PRD completo, pronto para gerar um sistema de ponta a ponta no Claude Code.",
  "default_locale": "pt_BR",
  "action": {
    "default_title": "PRD Generator",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
